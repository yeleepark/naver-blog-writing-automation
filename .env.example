# ── 필수 ─────────────────────────────────────────────
# 내 네이버 블로그 ID (blog.naver.com/<여기>)
NAVER_BLOG_ID=

# ── 스킬(.claude/skills/naver-blog/SKILL.md) 생성용 프로필 (선택, pnpm init-skill 이 사용) ──
BLOG_NAME=
BLOG_TAGLINE=
# 운영자·블로그 주제 한 줄 소개 (예: "직장인, 맛집·카페 후기 위주")
BLOG_PROFILE=
# 예: 맛집 · 카페 · 후기 · 정보
BLOG_CATEGORIES=
# 예: 지역 + 키워드 + 상호명 (+ 내돈내산 솔직 후기)
BLOG_TITLE_PATTERN=
# 예: 개인 경험 글은 평어체(~했다/~다), 정보 글은 합니다체
BLOG_TONE=

# ── 선택 ─────────────────────────────────────────────
# 디버깅 크롬 포트 (기본 9222)
CHROME_DEBUG_PORT=9222
# 사진 업로드 후 설명 입력 전 대기 시간(ms), 업로드가 느리면 늘리기 (기본 4000)
UPLOAD_SETTLE_MS=4000

# 네이버 검색광고 API (키워드 조사 `pnpm keywords`, 선택)
# searchad.naver.com > 도구 > API 사용 관리
NAVER_AD_CUSTOMER_ID=
NAVER_AD_ACCESS_KEY=
NAVER_AD_SECRET_KEY=
