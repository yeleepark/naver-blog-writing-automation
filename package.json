{
  "name": "naver-blog-writing-automation",
  "version": "0.1.0",
  "description": "Claude Code로 네이버 블로그 글을 쓰고, 내 로그인 크롬의 스마트에디터에 제목·본문·사진·지도까지 채워 주는 도구 (발행은 직접)",
  "license": "MIT",
  "type": "module",
  "keywords": ["naver", "blog", "claude-code", "playwright", "smarteditor"],
